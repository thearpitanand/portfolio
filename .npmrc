# Strict pnpm configuration
# Isolated node_modules (no hoisting) is pnpm's default — phantom/undeclared deps are blocked.
engine-strict=true
strict-peer-dependencies=true
auto-install-peers=true
dedupe-peer-dependents=true
# Fail instead of silently ignoring an out-of-range or missing lockfile entry.
prefer-frozen-lockfile=true
